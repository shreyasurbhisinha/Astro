{
  "info": {
    "name": "AstroGuide Phase 1",
    "description": "Signup, login, and birth profiles. Set baseUrl, then run Register and copy the token into the token variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "profileId", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@example.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Create profile",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/profiles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha\",\n  \"dateOfBirth\": \"1994-03-12\",\n  \"timeOfBirth\": \"14:35\",\n  \"birthplace\": \"Kochi, Kerala, India\"\n}"
        }
      }
    },
    {
      "name": "List profiles",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/profiles"
      }
    },
    {
      "name": "Get profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/profiles/{{profileId}}"
      }
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/profiles/{{profileId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Nair\",\n  \"dateOfBirth\": \"1994-03-12\",\n  \"timeOfBirth\": \"14:35:00\",\n  \"birthplace\": \"Kochi, Kerala, India\"\n}"
        }
      }
    },
    {
      "name": "Delete profile",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/profiles/{{profileId}}"
      }
    }
  ]
}
